{
  "manifest_version": 3,
  "name": "Markdown Previewer for Dropbox",
  "version": "1.1.0",
  "description": "Replaces Dropbox's Markdown view with clean GitHub-style formatting, tables, task lists and code highlighting.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.dropbox.com/*"],
      "js": ["lib/marked.min.js", "lib/purify.min.js", "lib/highlight.min.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["https://previews.dropbox.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["lib/*.css", "preview.css"],
      "matches": ["https://www.dropbox.com/*"]
    }
  ]
}
